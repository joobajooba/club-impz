{
  "name": "club-impz-web-wallet",
  "private": true,
  "description": "Glyph wallet connection for the Club Impz web build (see README.md).",
  "type": "module",
  "scripts": {
    "build": "esbuild src/glyph-wallet.js --bundle --minify --format=iife --platform=browser --target=es2020 --define:global=globalThis --define:process.env.NODE_ENV='\"production\"' --outfile=dist/glyph-wallet.js",
    "export": "node scripts/export-web.mjs",
    "serve": "npm --prefix ../game-server install --silent && node ../game-server/server.mjs 8060",
    "start": "npm run build && npm run export && npm run serve"
  },
  "dependencies": {
    "@privy-io/cross-app-connect": "0.7.6",
    "buffer": "6.0.3",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
