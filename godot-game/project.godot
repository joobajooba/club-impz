[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="player"
3d_physics/layer_3="props"
3d_physics/layer_4="triggers"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=12.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.56, 0.78, 0.94, 1)
